# Copy to .env.local (Next.js) — never commit real values.

# ---- LINE adapter (spec §7) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- Two-phone review demo (docs/LINE-UX-SPEC.md) ----
# Set both variables together and use two different LINE User IDs. The subject
# is the code constant `subj-father` and has no environment override.
LINE_DEMO_ELDER_USER_ID=
LINE_DEMO_CAREGIVER_USER_ID=

# Created by `npm run richmenu:register`; set both on the same Vercel project
# that serves /api/line/webhook.
LINE_RICH_MENU_ELDER_ID=
LINE_RICH_MENU_CAREGIVER_ID=

# Migration fallback only. New deployments should use LINE_DEMO_ELDER_USER_ID.
LINE_ELDER_USER_ID=

# Leave false for the fixed two-phone demo. This flag does not replace the
# per-phone allowlist above.
MEDBUDDY_ALLOW_ROLE_SWITCH=false

# ---- Shared persistence ----
# Vercel auto-provisions this for a connected Blob store. When present locally
# or on Vercel, logs and role bindings use Blob; when absent, process memory is
# used and disappears on restart.
BLOB_READ_WRITE_TOKEN=

# ---- Optional LINE audio output ----
# Required only when delivering stored audio through signed, short-lived URLs.
AUDIO_PUBLIC_BASE_URL=
AUDIO_URL_SIGNING_SECRET=

# ---- Cloned caregiver voice (optional, TDD §2 and §8) ----
# A Fish key alone does not enable speech: a voice id is also required. The
# current build has no user-facing voice-registration flow. Use an external id
# from the server-side consented demo voice catalogue; request-supplied ids not
# in that catalogue receive HTTP 400. Without a key and voice, LINE delivery is
# text-only.
FISH_AUDIO_API_KEY=
MEDBUDDY_DEMO_VOICE_ID=

# ---- Caregiver observation extraction (optional) ----
# When absent, the complete caregiver paragraph is stored verbatim as `other`.
GEMINI_API_KEY=

# ---- Medication-bag transcription draft (optional) ----
# Sends the selected image to Anthropic. The result is always an unpersisted,
# human-review-required draft; it never enters the medication log by itself.
ANTHROPIC_API_KEY=

# ---- Clinician share links (QR) ----
# Signs the short-lived token behind the QR the family shows a doctor.
# Unset means no link can be minted at all — a predictable key would put
# every record one guess away.
SUMMARY_SHARE_SECRET=
