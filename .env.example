# Copy to .env.local (Next.js) — never commit real values.

# ---- LINE adapter (spec §7) ----
# Append this block to the repo's .env.example. NEVER commit real values.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- Two-phone review demo (docs/LINE-UX-SPEC.md) ----
# Use two different LINE User IDs. Both roles point to the fixed `subj-father` demo record.
LINE_DEMO_ELDER_USER_ID=
LINE_DEMO_CAREGIVER_USER_ID=

# Created by `npm run richmenu:register`; set both on the same Vercel project
# that serves NEXT_PUBLIC_BASE_URL and /api/line/webhook.
LINE_RICH_MENU_ELDER_ID=
LINE_RICH_MENU_CAREGIVER_ID=

# Migration fallback only. New deployments should use LINE_DEMO_ELDER_USER_ID.
LINE_ELDER_USER_ID=

AUDIO_PUBLIC_BASE_URL=       # base URL the signed audio route is served from (this deployment)
AUDIO_URL_SIGNING_SECRET=    # HMAC secret for signed short-lived audio URLs (Step 4)
# BLOB_READ_WRITE_TOKEN is auto-provisioned by the connected Vercel Blob store.

# ---- Cloned caregiver voice (optional, TDD §2 and §8) ----
# Leave unset and the product makes no external call at all: the browser's own
# speech synthesis runs on the device. Setting this enables a caregiver to
# register their own voice, and is the one place a medication explanation is
# sent to a third party.
FISH_AUDIO_API_KEY=

# ---- Clinician share links (QR) ----
# Signs the short-lived token behind the QR the family shows a doctor.
# Unset means no link can be minted at all — a predictable key would put
# every record one guess away.
SUMMARY_SHARE_SECRET=

# Absolute origin used when building share URLs, e.g. https://medbuddy-app.vercel.app
NEXT_PUBLIC_BASE_URL=
