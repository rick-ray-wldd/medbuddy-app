# Copy to .env.local (Next.js) — never commit real values.

# ---- LINE adapter (spec §7) ----
# Append this block to the repo's .env.example. NEVER commit real values.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ELDER_USER_ID=          # test recipient during development
AUDIO_PUBLIC_BASE_URL=       # base URL the signed audio route is served from (this deployment)
AUDIO_URL_SIGNING_SECRET=    # HMAC secret for signed short-lived audio URLs (Step 4)
# BLOB_READ_WRITE_TOKEN is auto-provisioned by the connected Vercel Blob store.

# ---- Cloned caregiver voice (optional, TDD §2 and §8) ----
# Leave unset and the product makes no external call at all: the browser's own
# speech synthesis runs on the device. Setting this enables a caregiver to
# register their own voice, and is the one place a medication explanation is
# sent to a third party.
FISH_AUDIO_API_KEY=
